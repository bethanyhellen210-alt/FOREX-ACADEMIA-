# PostgreSQL connection string. Required for accounts and payment records.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Paystack API keys: keep the secret key server-side only.
# Start with a test secret key (sk_test_...). Never commit real keys.
PAYSTACK_SECRET_KEY="sk_test_REPLACE_WITH_YOUR_TEST_SECRET_KEY"

# Paystack account currency. Must be supported by your Paystack account.
PAYSTACK_CURRENCY="USD"

# Amounts in the currency's smallest unit: USD 19.00 = 1900; USD 149.00 = 14900.
# Change these to match the currency and prices configured in your Paystack account.
PAYSTACK_MONTHLY_AMOUNT="1900"
PAYSTACK_YEARLY_AMOUNT="14900"

# Canonical public URL of the deployed site, without a trailing slash.
NEXT_PUBLIC_SITE_URL="https://your-project.vercel.app"
